    "tauri:build:adhoc": "tauri build && codesign --force --sign - --entitlements src-tauri/Entitlements.plist \"src-tauri/target/release/bundle/macos/Genisys.app\" && codesign --verify --deep --strict --verbose=2 \"src-tauri/target/release/bundle/macos/Genisys.app\" && echo \"\\n✅ Ad-hoc signed with camera/mic entitlements: src-tauri/target/release/bundle/macos/Genisys.app\"",
    "setup:signing-cert": "bash scripts/setup-codesign-cert.sh",
    "tauri:build:adhoc:stable": "tauri build && codesign --force --sign \"Genisys Local\" --entitlements src-tauri/Entitlements.plist \"src-tauri/target/release/bundle/macos/Genisys.app\" && codesign --verify --deep --strict --verbose=2 \"src-tauri/target/release/bundle/macos/Genisys.app\" && echo \"\\n✅ Signed with stable 'Genisys Local' identity (Accessibility grant persists across rebuilds): src-tauri/target/release/bundle/macos/Genisys.app\"",
